# Independent SageAttention candidate. The production and MXFP8 baseline
# Dockerfiles are intentionally untouched.
# syntax=docker/dockerfile:1.7

FROM nvidia/cuda:13.0.2-devel-ubuntu24.04 AS sage-builder

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=12.0 \
    MAX_JOBS=32 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update -qq && apt-get install -y -qq \
      git python3.12 python3.12-dev python3.12-venv \
      build-essential ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    python3.12 -m venv /sage-venv && \
    /sage-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel ninja packaging && \
    /sage-venv/bin/pip install --no-cache-dir \
      torch==2.12.0 torchvision torchaudio \
      --index-url https://download.pytorch.org/whl/cu130

# Official SageAttention v2.2.0 source build, targeted explicitly at SM120.
RUN git clone --depth 1 --branch v2.2.0 \
      https://github.com/thu-ml/SageAttention.git /tmp/SageAttention && \
    /sage-venv/bin/pip wheel --no-build-isolation --no-deps \
      /tmp/SageAttention -w /wheelhouse && \
    test -s /wheelhouse/sageattention-2.2.0-*.whl

RUN /sage-venv/bin/python - <<'PY'
import glob
import torch
print(f"[sage-builder] torch={torch.__version__} cuda={torch.version.cuda}")
print("[sage-builder] TORCH_CUDA_ARCH_LIST=12.0")
print("[sage-builder] wheels=" + ",".join(glob.glob('/wheelhouse/*.whl')))
PY

# Runtime remains the already-verified MXFP8 H3 worker image.
FROM ghcr.io/gc5fss2v88-creator/minimax-h3-blackwell:mxfp8-candidate-code AS runtime

# RunPod can close the worker log pipe while ComfyUI is initializing tqdm. Do
# not turn that logging disconnect into a failed sampler execution.
RUN /opt/venv/bin/python - <<'PY'
from pathlib import Path

path = Path('/comfyui/app/logger.py')
text = path.read_text()
old = '''    def write(self, data):
        entry = {"t": datetime.now().isoformat(), "m": data}
        with self._lock:
            self._logs_since_flush.append(entry)

            # Simple handling for cr to overwrite the last output if it isnt a full line
            # else logs just get full of progress messages
            if isinstance(data, str) and data.startswith("\\r") and not logs[-1]["m"].endswith("\\n"):
                logs.pop()
            logs.append(entry)
        super().write(data)

    def flush(self):
        super().flush()
        for cb in self._flush_callbacks:
            cb(self._logs_since_flush)
            self._logs_since_flush = []
'''
new = '''    def write(self, data):
        entry = {"t": datetime.now().isoformat(), "m": data}
        with self._lock:
            self._logs_since_flush.append(entry)

            # Simple handling for cr to overwrite the last output if it isnt a full line
            # else logs just get full of progress messages
            if isinstance(data, str) and data.startswith("\\r") and not logs[-1]["m"].endswith("\\n"):
                logs.pop()
            logs.append(entry)
        try:
            return super().write(data)
        except BrokenPipeError:
            return len(data) if isinstance(data, str) else 0

    def flush(self):
        try:
            super().flush()
        except BrokenPipeError:
            return
        for cb in self._flush_callbacks:
            try:
                cb(self._logs_since_flush)
            except BrokenPipeError:
                pass
            self._logs_since_flush = []
'''
if old not in text:
    raise SystemExit('expected ComfyUI logger implementation not found')
path.write_text(text.replace(old, new, 1))
PY

COPY --from=sage-builder /wheelhouse/sageattention-2.2.0-*.whl /tmp/
RUN /opt/venv/bin/pip install --no-cache-dir --no-deps /tmp/sageattention-2.2.0-*.whl && \
    rm -f /tmp/sageattention-2.2.0-*.whl

RUN /opt/venv/bin/python - <<'PY'
import glob
import torch
import sageattention
from sageattention import sageattn
print(f"[sage-runtime] sageattention={getattr(sageattention, '__version__', '2.2.0')}")
print(f"[sage-runtime] torch={torch.__version__} cuda={torch.version.cuda}")
print(f"[sage-runtime] sageattn={sageattn}")
print("[sage-runtime] extensions=" + ",".join(glob.glob('/opt/venv/lib/python3.12/site-packages/sageattention/*.so')))
PY

COPY handler.py /handler.py
COPY profiling.py /profiling.py
COPY workflows/h3_i2v_mxfp8_api.json /workflows/h3_i2v_api.json
COPY start-sage-candidate.sh /start-sage-candidate.sh
RUN chmod +x /start-sage-candidate.sh

ENV COMFYUI_PATH=/comfyui \
    COMFYUI_PORT=8188 \
    MODEL_PROFILE=mxfp8_blackwell_candidate \
    MODEL_VOLUME_PATH=/runpod-volume \
    ENABLE_ATTENTION=1 \
    ATTENTION_ARGS=--use-sage-attention \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["/start-sage-candidate.sh"]
